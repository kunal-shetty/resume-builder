# Google Gemini key for the AI features (server-side only; never prefix with NEXT_PUBLIC_).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-2.5-flash
# AI_RATE_LIMIT_PER_MINUTE=20
# EXPORT_RATE_LIMIT_PER_MINUTE=10
# Local PDF export uses your installed Chrome/Edge; set this if it isn't found automatically.
# CHROME_EXECUTABLE_PATH=
